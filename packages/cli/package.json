{
  "name": "@nordixgen/cli",
  "version": "0.1.0",
  "description": "Command line interface and interactive project generator for NordixGen",
  "repository": {
    "type": "git",
    "url": "https://github.com/NordixTech/NordixGen.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "nordixgen": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["nordixgen", "cli", "npx", "scaffolding", "generator"],
  "author": "Nordix",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@nordixgen/core": "workspace:*",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
