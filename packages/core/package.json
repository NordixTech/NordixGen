{
  "name": "@nordixgen/core",
  "version": "0.1.0",
  "description": "Configuration validation, shared resolved project model, and deterministic virtual file system for NordixGen",
  "repository": {
    "type": "git",
    "url": "https://github.com/NordixTech/NordixGen.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup && tsc --build --force",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "generate:schema": "pnpm run build && node ./scripts/generate-json-schema.mjs",
    "test:watch": "vitest"
  },
  "keywords": ["nordixgen", "core", "ast", "zod", "schema", "generator"],
  "author": "Nordix",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.84",
    "@ai-sdk/google": "4.0.101",
    "@ai-sdk/groq": "4.0.67",
    "@ai-sdk/openai": "4.0.98",
    "@ai-sdk/react": "4.0.151",
    "@better-auth/api-key": "1.7.10",
    "@better-auth/drizzle-adapter": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@faker-js/faker": "9.9.0",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@neondatabase/serverless": "0.10.4",
    "@tanstack/query-core": "5.80.7",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.14",
    "@vitest/coverage-v8": "^3.2.7",
    "ai": "7.0.147",
    "auth": "1.7.10",
    "better-auth": "1.7.10",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "nodemailer": "10.1.7",
    "react": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
