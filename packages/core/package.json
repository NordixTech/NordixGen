{
  "name": "@nordixgen/core",
  "version": "0.1.0",
  "description": "Configuration validation, normalized intermediate representation, and deterministic virtual file system for NordixGen",
  "repository": {
    "type": "git",
    "url": "https://github.com/NordixTech/NordixGen.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup && tsc --build --force",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "generate:schema": "pnpm run build && node ./scripts/generate-json-schema.mjs",
    "test:watch": "vitest"
  },
  "keywords": ["nordixgen", "core", "ast", "zod", "schema", "generator"],
  "author": "Nordix",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
