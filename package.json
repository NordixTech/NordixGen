{
  "name": "nordixgen-monorepo",
  "private": true,
  "description": "Initialize Nordix full-stack projects from strict YAML v2",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "vite": "7.3.7",
      "zod": "4.6.7",
      "body-parser": "2.4.0",
      "undici@7": "7.30.1",
      "glob@10": "10.5.0",
      "drizzle-kit>@esbuild-kit/esm-loader": "-"
    }
  },
  "scripts": {
    "release:prepare": "node tools/release/release.mjs prepare",
    "release:pack": "node tools/release/release.mjs pack",
    "release:publish": "node tools/release/release.mjs publish",
    "test:release": "node --test tools/release/lib.test.mjs",
    "test:package": "node tools/release/smoke.mjs",
    "build": "pnpm --filter \"./packages/*\" build",
    "test": "pnpm --filter \"./packages/*\" test",
    "generate:schema": "pnpm --filter @nordix-tech/nordixgen-core generate:schema",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --build",
    "example:docker": "node packages/cli/tests/docker-acceptance.mjs",
    "test:acceptance": "node packages/cli/tests/acceptance/run.mjs",
    "benchmark:authorization": "node packages/core/tests/run-performance.mjs"
  },
  "devDependencies": {
    "vite": "7.3.7",
    "@biomejs/biome": "1.9.4",
    "@hono/node-server": "2.1.5",
    "@playwright/test": "1.64.1",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "nordixgen",
    "cli",
    "scaffolding",
    "clean-architecture",
    "monorepo",
    "hono",
    "nextjs",
    "drizzle",
    "cloudflare"
  ],
  "author": "Nordix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NordixTech/NordixGen.git"
  },
  "bugs": {
    "url": "https://github.com/NordixTech/NordixGen/issues"
  },
  "homepage": "https://github.com/NordixTech/NordixGen#readme"
}
