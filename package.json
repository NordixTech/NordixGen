{
  "name": "nordixgen-monorepo",
  "private": true,
  "description": "Enterprise Declarative Architecture & Scaffolding Platform for Full-Stack Projects",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "test": "pnpm --filter \"./packages/*\" test",
    "generate:schema": "pnpm --filter @nordixgen/core generate:schema",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --build",
    "example:commerce": "node examples/full-stack-commerce/scripts/run.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@hono/node-server": "2.1.5",
    "@playwright/test": "1.64.1",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "nordixgen",
    "cli",
    "scaffolding",
    "clean-architecture",
    "monorepo",
    "hono",
    "nextjs",
    "drizzle",
    "cloudflare"
  ],
  "author": "Nordix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NordixTech/NordixGen.git"
  },
  "bugs": {
    "url": "https://github.com/NordixTech/NordixGen/issues"
  },
  "homepage": "https://github.com/NordixTech/NordixGen#readme"
}
