{
  "name": "nordixgen",
  "version": "0.1.0",
  "description": "Declarative and deterministic architecture & scaffolding engine for full-stack projects.",
  "type": "module",
  "bin": {
    "nordixgen": "./dist/bin/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/bin/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "generator",
    "architecture",
    "clean-architecture",
    "hexagonal",
    "hono",
    "nextjs",
    "drizzle",
    "cloudflare"
  ],
  "author": "Nordix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NordixTech/NordixGen.git"
  },
  "bugs": {
    "url": "https://github.com/NordixTech/NordixGen/issues"
  },
  "homepage": "https://github.com/NordixTech/NordixGen#readme",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
