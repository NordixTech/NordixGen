# Only YAML example sources are versioned; generated applications stay local.
/examples/**/*
!/examples/**/
!/examples/**/*.yaml
!/examples/**/*.yml
/examples/**/generated/

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.turbo/
out/
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.cursor/mcp.json
*.swp
*.swo

# Test & coverage
coverage/
.vitest/

# Generated sandboxes during tests
sandbox/
tmp/

# Local tooling cache
.nordixgen/
